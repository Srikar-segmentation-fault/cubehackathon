# Copy this file to .env and fill in real values. Never commit .env.

# --- VLM provider ---
# Uses any OpenAI-compatible Chat Completions API with a JSON-schema-forced
# response for the single batched perception call. Default below targets
# Groq (console.groq.com), which supports vision input + strict structured
# JSON output on qwen/qwen3.8-27b. Swap VLM_BASE_URL/VLM_MODEL to point at
# OpenAI, Azure OpenAI, or any other OpenAI-compatible endpoint without
# touching code.
VLM_API_KEY=gsk_...
VLM_BASE_URL=https://api.groq.com/openai/v1
VLM_MODEL=qwen/qwen3.8-27b
VLM_TIMEOUT_SECONDS=45
VLM_MAX_RETRIES=2

# --- Evidence store ---
# Day 1: local JSONL file store. Swap for a real DB later without changing
# the pipeline (rtn/audit/store.py defines the interface).
EVIDENCE_STORE_DIR=./evidence_store

# --- Multi-tenancy default (used by the Day 1 CLI/fixture only) ---
DEFAULT_ORGANIZATION_ID=org-demo
DEFAULT_CLIENT_ID=client-demo
